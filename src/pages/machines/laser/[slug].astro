---
import Layout from '../../../layouts/Layout.astro';
import {
  getLaserItems,
  monthlyPayment,
  getWorkingArea,
  getSeries,
  getSize,
  parseSpecSections,
} from '../../../lib/zoho.js';
import { META, LASER_SLUGS } from '../../../lib/machine_meta.js';
import PhotoSlot from '../../../components/PhotoSlot.astro';
import TrustBand from '../../../components/TrustBand.astro';

export async function getStaticPaths() {
  const items = getLaserItems();

  const bySeries = {};
  items.forEach(m => {
    const key = getSeries(m.name);
    if (!bySeries[key]) bySeries[key] = [];
    bySeries[key].push(m);
  });

  return Object.entries(LASER_SLUGS)
    .filter(([, seriesName]) => bySeries[seriesName]?.length)
    .map(([slug, seriesName]) => ({
      params: { slug },
      props: {
        seriesName,
        variants: bySeries[seriesName].slice().sort((a, b) => a.rate - b.rate),
      },
    }));
}

const { seriesName, variants } = Astro.props;
const meta = META[seriesName];

function fmt(n) {
  return '$' + Number(n).toLocaleString('en-US');
}

const minPrice = Math.min(...variants.map(v => v.rate));
const maxPrice = Math.max(...variants.map(v => v.rate));

const referenceVariant = variants[variants.length - 1];
const specs = parseSpecSections(referenceVariant.description);

const slugOrder = Object.keys(LASER_SLUGS);
const currentSlug = slugOrder.find(s => LASER_SLUGS[s] === seriesName);
const idx = slugOrder.indexOf(currentSlug);
const prevSlug = idx > 0 ? slugOrder[idx - 1] : null;
const nextSlug = idx < slugOrder.length - 1 ? slugOrder[idx + 1] : null;
const article = /^[AEIOU]/.test(seriesName) ? 'an' : 'a';
---

<Layout
  title={seriesName}
  description={`${seriesName} — ${meta.tagline}. ${meta.intro}`}
  currentPage="/machines"
>

  <div class="page-hero">
    <div class="page-hero-inner">
      <p class="page-hero-label">
        <a href="/machines" style="color: inherit;">// Machines</a> / {seriesName}
      </p>
      <h1 class="page-hero-title">{seriesName}</h1>
      <p class="page-hero-sub">{meta.tagline}</p>
    </div>
  </div>

  <div class="placeholder-banner">
    <div class="container">
      Pricing and specs on this page are placeholders pending final laser inventory — subject to change.
    </div>
  </div>

  <section style="padding: var(--section-pad) 24px 40px;">
    <div class="container">
      <div class="model-overview">
        <div>
          <span class={`s-badge ${meta.cls}`}>{meta.badge}</span>
          <PhotoSlot src={meta.image} alt={seriesName} label={seriesName} />
          <dl class="spec-strip">
            {meta.keySpecs?.map((s: any) => (
              <div class="spec-strip-item">
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>
          <p class="model-intro">{meta.intro}</p>
          {meta.bestFor && (
            <p class="model-bestfor"><strong>Best suited for:</strong> {meta.bestFor}</p>
          )}
        </div>
        <div class="model-price-box">
          <span class="spec-label">Starting At</span>
          <div class="model-price">
            {variants.length > 1 ? `${fmt(minPrice)} – ${fmt(maxPrice)}` : fmt(minPrice)}
          </div>
          <p class="model-price-sub">{variants.length} configuration{variants.length > 1 ? 's' : ''} available</p>
          <a href="/#contact" class="btn btn-primary" style="width:100%; justify-content:center; margin-top:12px;">Get a Quote</a>
          <a href="/financing" class="btn btn-outline" style="width:100%; justify-content:center; margin-top:10px; color:var(--dark); border-color:var(--border);">See Financing Options</a>
        </div>
      </div>
    </div>
  </section>

  <section style="padding: 0 24px 64px;">
    <div class="container">
      <p class="section-label">Configurations</p>
      <h2 class="section-title">Available Configurations &amp; Pricing</h2>
      <div class="title-rule"></div>
      <div class="variants-grid">
        {variants.map(v => {
          const size = getSize(v.name);
          const area = getWorkingArea(v.description);
          const mo   = monthlyPayment(v.rate);
          return (
            <div class="variant-card">
              <div class="vc-size">{size}</div>
              {area && <div class="vc-area">{area}</div>}
              <div class="vc-price">{fmt(v.rate)}</div>
              <div class="vc-monthly">Est. {fmt(mo)}/mo*</div>
              <a href="/#contact" class="btn btn-primary vc-btn">Get a Quote</a>
            </div>
          );
        })}
      </div>
      <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 16px;">
        *Monthly payment estimates based on 60-month term at ~8% APR. Subject to credit approval. Pricing is a placeholder pending final inventory.
      </p>
    </div>
  </section>

  <TrustBand publishedPricing={false} />

  {specs.sections.length > 0 && (
    <section style="padding: 0 24px 64px; background: var(--light);">
      <div class="container">
        <p class="section-label">Full Specifications</p>
        <h2 class="section-title">What's Included</h2>
        <div class="title-rule"></div>
        <p class="section-sub">Reference configuration: {getSize(referenceVariant.name)} {seriesName}.</p>
        <div class="spec-sections">
          {specs.sections.map(section => (
            <div class="spec-section">
              <h3 class="spec-section-heading">{section.heading}</h3>
              <ul class="spec-section-list">
                {section.items.map(item => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section style="padding: var(--section-pad); background: var(--dark);">
    <div class="container text-center">
      <p class="section-label">Custom</p>
      <h2 class="section-title white">Need {article} {seriesName} Built to Different Specs?</h2>
      <div class="title-rule"></div>
      <p class="section-sub" style="color: #aaa;">
        Different bed size, power, or accessories — we configure every machine to the shop that's buying it.
      </p>
      <a href="/#contact" class="btn btn-primary" style="margin-top: 32px;">Talk to Us About This Machine</a>
    </div>
  </section>

  <section style="padding: 40px 24px; background: var(--white);">
    <div class="container">
      <div class="model-nav">
        {prevSlug
          ? <a href={`/machines/laser/${prevSlug}`} class="model-nav-link">← {LASER_SLUGS[prevSlug]}</a>
          : <span></span>}
        <a href="/machines" class="model-nav-link model-nav-center">All Machines</a>
        {nextSlug
          ? <a href={`/machines/laser/${nextSlug}`} class="model-nav-link model-nav-right">{LASER_SLUGS[nextSlug]} →</a>
          : <span></span>}
      </div>
    </div>
  </section>

</Layout>

<style>
  .placeholder-banner {
    background: #fff7e6;
    border-bottom: 1px solid #f0d896;
    padding: 12px 24px;
    text-align: center;
    font-size: 0.85rem;
    color: #7a5c00;
  }
  .model-overview {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 48px;
    align-items: start;
  }
  .model-intro {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text);
    margin-top: 16px;
  }
  .model-price-box {
    background: var(--light);
    border: 1px solid var(--border);
    padding: 28px;
  }
  .model-price {
    font-family: var(--font-head);
    font-size: 2rem;
    font-weight: 800;
    color: var(--dark);
    margin-top: 6px;
  }
  .model-price-sub {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 4px;
  }
  .spec-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 16px; margin-top: 20px; padding: 18px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .spec-strip-item { display: flex; flex-direction: column; gap: 3px; }
  .spec-strip-item dt { font-family: var(--font-head); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); }
  .spec-strip-item dd { font-size: 0.92rem; font-weight: 600; color: var(--dark); }
  .model-bestfor { margin-top: 18px; font-size: 0.95rem; color: var(--text); }
  .model-bestfor strong { font-family: var(--font-head); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.85rem; }
  .spec-sections {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 32px;
    margin-top: 32px;
  }
  .spec-section-heading {
    font-family: var(--font-head);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--dark);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--accent);
  }
  .spec-section-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .spec-section-list li {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text);
    padding-left: 16px;
    position: relative;
  }
  .spec-section-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    background: var(--accent);
  }
  .model-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }
  .model-nav-link {
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--accent);
    text-decoration: none;
  }
  .model-nav-link:hover { text-decoration: underline; }
  .model-nav-center { text-align: center; color: var(--dark); }
  .model-nav-right { text-align: right; }
  @media (max-width: 800px) {
    .model-overview { grid-template-columns: 1fr; }
    .model-nav { grid-template-columns: 1fr; text-align: center; gap: 12px; }
    .model-nav-right { text-align: center; }
  }
</style>
