---
import Layout from '../layouts/Layout.astro';
import {
  fetchZohoItems,
  categorizeMachines,
  getLaserItems,
  getSeries,
} from '../lib/zoho.js';
import { META, slugForSeries, laserSlugForSeries } from '../lib/machine_meta.js';
import MachineCard from '../components/MachineCard.astro';
import TrustBand from '../components/TrustBand.astro';
import RouterComparison from '../components/RouterComparison.astro';

const items = await fetchZohoItems();
const { plasma, routers, specialty } = categorizeMachines(items);
const lasers = getLaserItems();

/* ── Helpers ─────────────────────────────────────── */
function groupBySeries(machines) {
  const map = {};
  machines.forEach(m => {
    const key = getSeries(m.name);
    if (!map[key]) map[key] = [];
    map[key].push(m);
  });
  Object.values(map).forEach(arr => arr.sort((a, b) => a.rate - b.rate));
  return map;
}

/* ── Group by series ─────────────────────────────── */
const plasmaByS = groupBySeries(plasma);
const routerByS = groupBySeries(routers);
const specByS   = groupBySeries(specialty);
const laserByS  = groupBySeries(lasers);

const plasmaSeries = ['Spark Series','ION Series','Prime Series'].filter(s => plasmaByS[s]);
const routerSeries = ['Ridge Series','Ascent Series','Summit Series','Summit ATC','Apex Series'].filter(s => routerByS[s]);
const specSeries   = ['Summit Lathe','BoreLine'].filter(s => specByS[s]);
const laserSeries  = ['CO2 Laser Series','Fiber Laser Series'].filter(s => laserByS[s]);
---

<Layout title="CNC Machines" description="Full Elevate CNC machine lineup — CNC Routers (Ascent, Ridge, Summit, Apex), CO2/Fiber Laser Systems, and Specialty Machines." currentPage="/machines">

  <!-- HERO -->
  <div class="page-hero">
    <div class="page-hero-inner">
      <p class="page-hero-label">// Full Machine Lineup</p>
      <h1 class="page-hero-title">Find Your Machine</h1>
      <p class="page-hero-sub">Every series, with sizes and pricing — the full lineup in one place.</p>
    </div>
  </div>

  <!-- CATEGORY JUMP NAV -->
  <nav class="cat-nav" aria-label="Machine categories">
    <div class="container">
      <div class="cat-nav-inner">
        <a href="#routers"   class="cat-nav-item">CNC Routers</a>
        <a href="#lasers"    class="cat-nav-item">Laser Systems</a>
        <a href="#specialty" class="cat-nav-item">Specialty Machines</a>
        <a href="#custom"    class="cat-nav-item">Custom Builds</a>
      </div>
    </div>
  </nav>

  <TrustBand />

  <!-- ══════════════════════════════════════════════ -->
  <!-- CNC ROUTERS                                    -->
  <!-- ══════════════════════════════════════════════ -->
  <section id="routers" class="machine-section" style="background: var(--white);">
    <div class="container">
      <p class="section-label">CNC Routers</p>
      <h2 class="section-title">From Entry-Level to Industrial</h2>
      <div class="title-rule"></div>
      <p class="section-sub">Covering every budget and production level, from an extrusion-frame platform to a fully welded industrial machine.</p>

      <div class="machine-grid">
        {routerSeries.map(seriesKey => (
          <MachineCard
            seriesName={seriesKey}
            meta={META[seriesKey]}
            variants={routerByS[seriesKey]}
            detailHref={slugForSeries(seriesKey) ? `/machines/${slugForSeries(seriesKey)}` : null}
            featured={seriesKey === 'Summit Series'}
          />
        ))}
      </div>

      <div style="margin-top: 56px;">
        <p class="section-label">Compare</p>
        <h3 class="section-title" style="font-size: 1.8rem;">Router Comparison</h3>
        <div class="title-rule"></div>
        <RouterComparison series={routerSeries} bySeries={routerByS} />
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════ -->
  <!-- LASER SYSTEMS (placeholder pricing pending final inventory) -->
  <!-- ══════════════════════════════════════════════ -->
  <section id="lasers" class="machine-section" style="background: var(--light);">
    <div class="container">
      <p class="section-label">Laser Systems</p>
      <h2 class="section-title">CO2 &amp; Fiber Laser Cutting</h2>
      <div class="title-rule"></div>
      <p class="section-sub">
        Non-metal cutting/engraving and metal marking/cutting. Pricing below is a placeholder pending final inventory — confirm current pricing when you request a quote.
      </p>

      <div class="machine-grid">
        {laserSeries.map(seriesKey => (
          <MachineCard
            seriesName={seriesKey}
            meta={META[seriesKey]}
            variants={laserByS[seriesKey]}
            detailHref={laserSlugForSeries(seriesKey) ? `/machines/laser/${laserSlugForSeries(seriesKey)}` : null}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════ -->
  <!-- PLASMA TABLES (archived — not actively marketed, still reachable/quotable) -->
  <!-- ══════════════════════════════════════════════ -->
  <section id="plasma" class="machine-section" style="background: var(--white);">
    <div class="container">
      <p class="section-label">Plasma Tables</p>
      <h2 class="section-title">Cut Steel, Aluminum & Sheet Metal</h2>
      <div class="title-rule"></div>
      <p class="section-sub">From compact garage tables to production shop setups.</p>

      <div class="machine-grid">
        {plasmaSeries.map(seriesKey => (
          <MachineCard
            seriesName={seriesKey}
            meta={META[seriesKey]}
            variants={plasmaByS[seriesKey]}
            detailHref={null}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════ -->
  <!-- SPECIALTY                                       -->
  <!-- ══════════════════════════════════════════════ -->
  <section id="specialty" class="machine-section" style="background: var(--dark-2);">
    <div class="container">
      <p class="section-label" style="color: var(--accent);">Specialty Machines</p>
      <h2 class="section-title white">Purpose-Built Operations</h2>
      <div class="title-rule"></div>
      <p class="section-sub" style="color: #aaa;">Not general routing — dedicated industrial machines built for specific, high-volume operations.</p>

      <div class="machine-grid">
        {specSeries.map(seriesKey => (
          <MachineCard
            seriesName={seriesKey}
            meta={META[seriesKey]}
            variants={specByS[seriesKey]}
            detailHref={null}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════ -->
  <!-- CUSTOM CTA                                      -->
  <!-- ══════════════════════════════════════════════ -->
  <section id="custom" style="padding: var(--section-pad); background: var(--dark);">
    <div class="container text-center">
      <p class="section-label">Custom</p>
      <h2 class="section-title white">If It Doesn't Exist Off the Shelf, We Build It</h2>
      <div class="title-rule" style="margin-left:auto; margin-right:auto;"></div>
      <p class="section-sub" style="color:#aaa; max-width:640px; margin-left:auto; margin-right:auto;">
        Standard sizes are only where we start. Most of what we build is configured around a
        specific job — tell us what you're cutting and we'll tell you exactly what it takes.
      </p>
      <div class="custom-examples">
        <div class="custom-example">
          <h3>Non-Standard Sizes</h3>
          <p>An 8×30 bed. A machine sized around your material, not a catalog page.</p>
        </div>
        <div class="custom-example">
          <h3>Purpose-Built Configurations</h3>
          <p>Spindle, drive system, and tooling chosen for what you actually cut every day.</p>
        </div>
        <div class="custom-example">
          <h3>Automation &amp; Add-Ons</h3>
          <p>Automatic tool changers, vacuum zoning, dust collection, and workholding built in from the start.</p>
        </div>
      </div>
      <p style="color:#888; font-size:0.85rem; margin-top:28px;">Custom builds are quote-only — pricing depends on the configuration.</p>
      <a href="/#contact" class="btn btn-primary" style="margin-top:12px;">Talk to Us About a Custom Build</a>
    </div>
  </section>

  <!-- Financing footnote -->
  <div style="background: var(--light); padding: 16px 24px; text-align: center;">
    <p style="font-size: 0.8rem; color: var(--text-muted);">
      Monthly payment estimates assume a 60-month term at ~8% APR. Subject to credit approval. Contact us for financing details.
    </p>
  </div>


</Layout>
