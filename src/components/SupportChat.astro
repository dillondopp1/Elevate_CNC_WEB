<!-- CNC12 Support Chat — answers only from the Centroid CNC12 manual -->

<div class="support-panel">
  <div class="support-header">
    <div class="support-agent">
      <div class="support-avatar">S</div>
      <div class="support-agent-info">
        <div class="support-agent-name">CNC12 Support</div>
        <div class="support-agent-title">Manual-based assistant · Elevate CNC</div>
      </div>
    </div>
    <div class="support-status">
      <span class="support-dot"></span> Online
    </div>
  </div>

  <div class="support-messages" id="support-messages">
    <div class="support-msg support-msg--agent">
      <div class="support-msg-bubble">I'm the CNC12 support assistant. I answer strictly from the Centroid CNC12 Router Operators Manual — control setup, offsets, parameters, error messages, and general operation. If something's outside the manual, or sounds like a wiring/electrical/safety issue, I'll tell you to contact us directly rather than guess. What's going on with your machine?</div>
    </div>
  </div>

  <div class="support-input-row">
    <input
      class="support-input"
      id="support-input"
      type="text"
      placeholder="Describe the issue or error message..."
      autocomplete="off"
      maxlength="500"
    />
    <button class="support-send" id="support-send" aria-label="Send">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="22" y1="2" x2="11" y2="13"></line>
        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
      </svg>
    </button>
  </div>
  <p class="support-disclaimer">
    Answers are pulled from the CNC12 manual only. For wiring, electrical, or safety issues, always contact us directly at
    <a href="tel:+12085571587">(208) 557-1587</a>.
  </p>
</div>

<style is:global>
  .support-panel {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    height: 560px;
    max-height: 75vh;
    background: #161b22;
    border: 1px solid #2d3748;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 60px rgba(0,0,0,0.35);
    overflow: hidden;
  }

  .support-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 18px;
    border-bottom: 1px solid #2d3748;
    flex-shrink: 0;
  }
  .support-agent { display: flex; align-items: center; gap: 10px; }
  .support-avatar {
    width: 38px;
    height: 38px;
    background: linear-gradient(135deg, var(--accent, #1a6ed8), #0d3d8a);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-head, 'Barlow Condensed', sans-serif);
    font-size: 1.1rem;
    font-weight: 900;
    color: #fff;
    flex-shrink: 0;
  }
  .support-agent-name {
    font-family: var(--font-head, 'Barlow Condensed', sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .support-agent-title {
    font-size: 0.72rem;
    color: #8a9bb0;
    margin-top: 1px;
  }
  .support-status {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.72rem;
    color: #8a9bb0;
  }
  .support-dot {
    width: 7px;
    height: 7px;
    background: #48bb78;
    border-radius: 50%;
    animation: support-pulse 2s infinite;
  }
  @keyframes support-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .support-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px 16px 8px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    scroll-behavior: smooth;
  }
  .support-messages::-webkit-scrollbar { width: 4px; }
  .support-messages::-webkit-scrollbar-track { background: transparent; }
  .support-messages::-webkit-scrollbar-thumb { background: #2d3748; border-radius: 4px; }

  .support-msg { display: flex; }
  .support-msg--agent { justify-content: flex-start; }
  .support-msg--user  { justify-content: flex-end; }

  .support-msg-bubble {
    max-width: 90%;
    padding: 11px 14px;
    border-radius: 12px;
    font-size: 0.875rem;
    line-height: 1.6;
    white-space: pre-wrap;
  }
  .support-msg--agent .support-msg-bubble {
    background: #21262d;
    color: #ffffff;
    border-bottom-left-radius: 3px;
  }
  .support-msg--user .support-msg-bubble {
    background: var(--accent, #1a6ed8);
    color: #fff;
    border-bottom-right-radius: 3px;
  }

  .support-typing .support-msg-bubble {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 13px 16px;
  }
  .support-typing-dot {
    width: 6px;
    height: 6px;
    background: #8a9bb0;
    border-radius: 50%;
    animation: support-typing 1.2s infinite;
  }
  .support-typing-dot:nth-child(2) { animation-delay: 0.2s; }
  .support-typing-dot:nth-child(3) { animation-delay: 0.4s; }
  @keyframes support-typing {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-5px); opacity: 1; }
  }

  .support-input-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    border-top: 1px solid #2d3748;
    flex-shrink: 0;
  }
  .support-input {
    flex: 1;
    background: #21262d;
    border: 1px solid #2d3748;
    border-radius: 8px;
    color: #e2e8f0;
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 0.875rem;
    padding: 10px 12px;
    outline: none;
    transition: border-color 0.2s;
  }
  .support-input::placeholder { color: #4a5568; }
  .support-input:focus { border-color: var(--accent, #1a6ed8); }

  .support-send {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    background: var(--accent, #1a6ed8);
    border: none;
    border-radius: 8px;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, transform 0.1s;
  }
  .support-send:hover { background: var(--accent-dark, #1050a8); }
  .support-send:active { transform: scale(0.93); }
  .support-send:disabled { opacity: 0.4; cursor: not-allowed; }

  .support-disclaimer {
    font-size: 0.72rem;
    color: #6b7688;
    text-align: center;
    padding: 0 14px 14px;
    line-height: 1.5;
  }
  .support-disclaimer a { color: var(--accent, #1a6ed8); }

  @media (max-width: 480px) {
    .support-panel { height: 70vh; }
  }
</style>

<script>
  const input   = document.getElementById('support-input') as HTMLInputElement;
  const sendBtn = document.getElementById('support-send') as HTMLButtonElement;
  const msgContainer = document.getElementById('support-messages')!;

  let messages: { role: string; content: string }[] = [];
  let busy = false;

  function appendMessage(role: 'user' | 'agent', text: string) {
    const wrapper = document.createElement('div');
    wrapper.className = `support-msg support-msg--${role}`;
    const bubble = document.createElement('div');
    bubble.className = 'support-msg-bubble';
    if (role === 'agent') {
      bubble.innerHTML = text
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\n/g, '<br>');
    } else {
      bubble.textContent = text;
    }
    wrapper.appendChild(bubble);
    msgContainer.appendChild(wrapper);
    msgContainer.scrollTop = msgContainer.scrollHeight;
    return wrapper;
  }

  function showTyping() {
    const wrapper = document.createElement('div');
    wrapper.className = 'support-msg support-msg--agent support-typing';
    wrapper.id = 'support-typing';
    wrapper.innerHTML = `<div class="support-msg-bubble">
      <span class="support-typing-dot"></span>
      <span class="support-typing-dot"></span>
      <span class="support-typing-dot"></span>
    </div>`;
    msgContainer.appendChild(wrapper);
    msgContainer.scrollTop = msgContainer.scrollHeight;
  }

  function removeTyping() {
    document.getElementById('support-typing')?.remove();
  }

  async function sendMessage() {
    const text = input.value.trim();
    if (!text || busy) return;

    busy = true;
    sendBtn.disabled = true;
    input.value = '';

    appendMessage('user', text);
    messages.push({ role: 'user', content: text });
    showTyping();

    try {
      const res = await fetch('/.netlify/functions/support-chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages }),
      });

      removeTyping();

      if (!res.ok) {
        appendMessage('agent', "I hit an error looking that up. Please try again, or call us at (208) 557-1587.");
        busy = false;
        sendBtn.disabled = false;
        return;
      }

      const data = await res.json();

      if (data.response) {
        messages.push({ role: 'assistant', content: data.response });
        appendMessage('agent', data.response);
      }
    } catch {
      removeTyping();
      appendMessage('agent', 'Connection error. Please try again.');
    }

    busy = false;
    sendBtn.disabled = false;
    input.focus();
  }

  sendBtn.addEventListener('click', sendMessage);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });
</script>
